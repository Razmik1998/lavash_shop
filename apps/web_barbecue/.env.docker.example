# Copy to .env before running docker compose (never commit the real .env).
#   cp .env.docker.example .env
#
# This is the environment used INSIDE the containers (docker-compose.yml
# -> env_file: .env), separate from .env.example which is for running
# `python manage.py runserver` directly on a dev machine.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=False

# Public IP and/or domain name(s) of the EC2 instance, comma-separated.
ALLOWED_HOSTS=203.0.113.10,shop.example.com

# Must include scheme; used for CSRF checks on POST forms served over HTTPS.
CSRF_TRUSTED_ORIGINS=https://shop.example.com

# Shared secret the admin desktop app's web_sync_client.py sends as
# X-API-Key on POST /api/products/sync/. Must match the admin app's config.
WEB_SYNC_API_KEY=change-me-shared-secret

# Telegram order processing. Never commit a real bot token.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# Where the SQLite file lives inside the container; matches the
# sqlite_data volume mount in docker-compose.yml. Leave as-is.
SQLITE_PATH=/app/data/db.sqlite3

# Redis channel layer backing the /ws/admin/orders/ WebSocket consumer.
# Matches the `redis` service name in docker-compose.yml. Leave as-is.
REDIS_URL=redis://redis:6379/0
